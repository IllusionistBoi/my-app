# Local development only. Export these values before running Django.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=false

# Production must set DJANGO_DEBUG=false and provide managed PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
# DB_SSL_REQUIRED=true
# SESSION_TTL_SECONDS=604800
# CAPABILITY_MAX_AGE_SECONDS=2592000
# API_SESSION_CREATE_RATE=20/hour
# API_SESSION_JOIN_RATE=60/hour
# VERCEL_GIT_COMMIT_SHA is provided automatically on Vercel deployments.
