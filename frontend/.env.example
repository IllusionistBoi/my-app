# Optional. Leave unset to use Vite's local proxy and Vercel's same-origin /api proxy.
VITE_API_URL=/api

# A preview deployment should point at an isolated staging backend.
# VITE_API_URL=https://staging-api.example.com/api

# Optional local-only Vite proxy target. This is not exposed to browser code.
# DEV_API_PROXY_TARGET=https://planning-poker-api-preview.example.com
